{"id":"AIOS-INTEGRATION-000001","name":"CLI Integration","version":"1.0.0","description":"Contract between HelpOfAi CLI and the AIOS module system. Specifies how the CLI discovers modules, resolves capabilities, builds workflows, caches brain data, assembles prompts, loads plugins, and manages profiles.","target_cli_version":"0.8.89","api_version":"1.0.0","entry_points":{"module_discovery":"aios/registry/modules.json","capability_resolution":"aios/registry/capabilities.json","dependency_resolution":"aios/registry/dependencies.json","constitution":"aios/constitution/constitution.json","module_manifest_pattern":"aios/{module}/module.json","contract_pattern":"aios/{module}/contracts/{contract}.json","workflow_pattern":"aios/workflows/WORKFLOW-*-*.json","agent_pattern":"aios/agents/AGENT-*-*.json","prompt_pattern":"aios/agents/prompts/AGENT-*-*.md","brain_data":"aios/.cache/brain/","plugin_pattern":"plugins/{plugin}/manifest.json"}}